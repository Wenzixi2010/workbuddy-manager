diff --git a/internal/server/account_scope.go b/internal/server/account_scope.go
new file mode 100644
--- /dev/null
+++ b/internal/server/account_scope.go
@@ -0,0 +1,144 @@
+package server
+
+import (
+	"crypto/hmac"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"time"
+
+	"workbuddy2api/internal/auth"
+	"workbuddy2api/internal/upstream"
+)
+
+// A manager-signed, request-local scope. Never stored in the pool: concurrent
+// keys must not change one another's candidates or bypass filtering on retries.
+type accountScope struct {
+	Version  int      `json:"version"`
+	Key      string   `json:"key"`
+	Issued   int64    `json:"issued"`
+	Allow    []string `json:"allow"`
+	Deny     []string `json:"deny"`
+	allowSet map[string]bool
+	denySet  map[string]bool
+}
+
+func parseAccountScope(r *http.Request, apiKey string) (*accountScope, error) {
+	value := r.Header.Get("X-WB-Account-Scope")
+	if value == "" {
+		return nil, nil
+	}
+	if apiKey == "" || len(value) > 65536 {
+		return nil, errors.New("invalid account scope")
+	}
+	sig, err := hex.DecodeString(r.Header.Get("X-WB-Account-Scope-Signature"))
+	mac := hmac.New(sha256.New, []byte(apiKey))
+	mac.Write([]byte(value))
+	if err != nil || !hmac.Equal(sig, mac.Sum(nil)) {
+		return nil, errors.New("invalid account scope signature")
+	}
+	raw, err := base64.RawURLEncoding.DecodeString(value)
+	if err != nil {
+		return nil, errors.New("invalid account scope")
+	}
+	var rule accountScope
+	if json.Unmarshal(raw, &rule) != nil || rule.Version != 1 || rule.Key == "" ||
+		rule.Issued < time.Now().Unix()-60 || rule.Issued > time.Now().Unix()+30 {
+		return nil, errors.New("invalid or expired account scope")
+	}
+	rule.allowSet = make(map[string]bool)
+	rule.denySet = make(map[string]bool)
+	for _, id := range rule.Allow {
+		rule.allowSet[id] = true
+	}
+	for _, id := range rule.Deny {
+		rule.denySet[id] = true
+	}
+	return &rule, nil
+}
+
+func (s *accountScope) permitsID(realm, uid string) bool {
+	if s == nil {
+		return true
+	}
+	if realm == "" {
+		realm = "cn"
+	}
+	id := realm + ":" + uid
+	return !s.denySet[id] && (s.Allow == nil || s.allowSet[id])
+}
+
+func (s *accountScope) permits(a *auth.Auth) bool {
+	if a == nil {
+		return false
+	}
+	if s == nil {
+		return true
+	}
+	id := a.AccountScopeID()
+	return !s.denySet[id] && (s.Allow == nil || s.allowSet[id])
+}
+
+func (h *Handler) scopedExclusions(s *accountScope, tried map[string]bool) map[string]bool {
+	if s == nil {
+		return tried
+	}
+	out := make(map[string]bool, len(tried))
+	for uid, v := range tried {
+		out[uid] = v
+	}
+	for _, a := range h.cfg.Pool.List() {
+		if !s.permits(h.cfg.Pool.AuthByUID(a.UID)) {
+			out[a.UID] = true
+		}
+	}
+	return out
+}
+
+// Old upstreams return 404 for this path rather than ignoring a scope header.
+func (h *Handler) scopedChatCompletions(w http.ResponseWriter, r *http.Request) {
+	if r.Header.Get("X-WB-Account-Scope") == "" {
+		writeOpenAIError(w, http.StatusForbidden, "missing_account_scope", "account scope is required")
+		return
+	}
+	h.chatCompletions(w, r)
+}
+
+func (h *Handler) scopedModels(w http.ResponseWriter, r *http.Request) {
+	rule, err := parseAccountScope(r, h.cfg.APIKey)
+	if err != nil || rule == nil {
+		writeOpenAIError(w, http.StatusForbidden, "invalid_account_scope", "valid account scope is required")
+		return
+	}
+	writeJSON(w, http.StatusOK, map[string]any{"object": "list", "data": h.modelListScoped(rule)})
+}
+
+func (h *Handler) fetchScopedCNModels(rule *accountScope) []upstream.ModelInfo {
+	if rule == nil {
+		return h.fetchDynamicModels()
+	}
+	account := h.cfg.Pool.PickExcludingForRealm(h.scopedExclusions(rule, nil), "", "cn")
+	if !rule.permits(account) {
+		return nil
+	}
+	// The unrestricted cache may describe another account's capabilities.
+	models, err := h.cfg.Upstream.FetchModels(account)
+	if err != nil {
+		return nil
+	}
+	return models
+}
+
+func (h *Handler) fetchScopedGlobalModels(rule *accountScope) ([]string, *auth.Auth) {
+	if rule == nil {
+		return h.fetchGlobalModels()
+	}
+	account := h.cfg.Pool.PickExcludingForRealm(h.scopedExclusions(rule, nil), "", "global")
+	if !rule.permits(account) {
+		return nil, nil
+	}
+	return h.cfg.Upstream.FetchGlobalModels(account), account
+}
