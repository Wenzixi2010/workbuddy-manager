+// AccountScopeID is stable across routing escape-hatch changes. Permissions
+// describe a credential, not the realm selected by a temporary routing switch.
+func (a *Auth) AccountScopeID() string {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	realm := strings.ToLower(strings.TrimSpace(a.realm))
+	if realm != "cn" && realm != "global" {
+		realm = ""
+	}
+	return ResolveRealm(realm, a.Domain) + ":" + a.UID
 }
 
