@@ -0,0 +1,137 @@
+package server
+
+import (
+	"crypto/hmac"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+	"workbuddy2api/internal/auth"
+	"workbuddy2api/internal/session"
+)
+
+func signedScopeRequest(key string, allow, deny []string) *http.Request {
+	r := httptest.NewRequest("POST", "/v1/scoped/chat/completions", strings.NewReader(`{"model":"glm-5.2","stream":true,"messages":[],"metadata":{"conversation_id":"shared"}}`))
+	r.Header.Set("Authorization", "Bearer manager-secret")
+	raw, _ := json.Marshal(accountScope{Version: 1, Key: key, Issued: time.Now().Unix(), Allow: allow, Deny: deny})
+	value := base64.RawURLEncoding.EncodeToString(raw)
+	mac := hmac.New(sha256.New, []byte("manager-secret"))
+	mac.Write([]byte(value))
+	r.Header.Set("X-WB-Account-Scope", value)
+	r.Header.Set("X-WB-Account-Scope-Signature", hex.EncodeToString(mac.Sum(nil)))
+	return r
+}
+func TestAccountScopeSignatureAndEmptySelection(t *testing.T) {
+	r := signedScopeRequest("key", []string{"cn:a"}, nil)
+	rule, err := parseAccountScope(r, "manager-secret")
+	if err != nil || !rule.permitsID("cn", "a") || rule.permitsID("global", "a") || rule.permitsID("cn", "b") {
+		t.Fatalf("invalid scope %v %v", rule, err)
+	}
+	r.Header.Set("X-WB-Account-Scope-Signature", "invalid")
+	if _, err := parseAccountScope(r, "manager-secret"); err == nil {
+		t.Fatal("forged scope accepted")
+	}
+	rule, err = parseAccountScope(signedScopeRequest("key", []string{}, nil), "manager-secret")
+	if err != nil || rule.permitsID("cn", "a") {
+		t.Fatal("empty allowlist became public")
+	}
+	rule, err = parseAccountScope(signedScopeRequest("key", nil, []string{"cn:a"}), "manager-secret")
+	if err != nil || rule.permitsID("cn", "a") || !rule.permitsID("cn", "b") {
+		t.Fatal("denylist ignored")
+	}
+}
+func TestAccountScopeRequiredOnDedicatedRoutes(t *testing.T) {
+	h := NewHandler(Config{APIKey: "manager-secret"})
+	for _, path := range []string{"/v1/scoped/chat/completions", "/v1/scoped/models"} {
+		r := signedScopeRequest("key", nil, nil)
+		r.URL.Path = path
+		r.Header.Del("X-WB-Account-Scope")
+		if strings.HasSuffix(path, "models") {
+			r.Method = "GET"
+		}
+		w := httptest.NewRecorder()
+		h.ServeHTTP(w, r)
+		if w.Code != 403 {
+			t.Fatalf("%s missing scope: %d", path, w.Code)
+		}
+	}
+}
+func TestAccountScopeStickyLargeRequestAndChangedPermissions(t *testing.T) {
+	p := testPoolWith(&auth.Auth{UID: "a", AccessToken: "at-a", ExpiresAt: 9999999999}, &auth.Auth{UID: "b", AccessToken: "at-b", ExpiresAt: 9999999999})
+	sess := session.New(session.Config{TTL: time.Minute, Available: func() []string { return []string{"a", "b"} }})
+	sess.Bind("shared", "b")
+	var calls []string
+	up := newFakeUpstream(t, func(token string) (int, string, bool) { calls = append(calls, token); return 200, sseOK, true })
+	h := NewHandler(Config{Pool: p, Upstream: up, APIKey: "manager-secret", Session: sess, LargeRequestBytes: 1, LargeRequestBudget: 1, LargeRequestBudgetWindow: time.Minute})
+	for i := 0; i < 3; i++ {
+		w := httptest.NewRecorder()
+		h.ServeHTTP(w, signedScopeRequest("key", []string{"cn:a"}, nil))
+		if w.Code != 200 {
+			t.Fatalf("%d %s", w.Code, w.Body)
+		}
+	}
+	if len(calls) != 3 {
+		t.Fatalf("calls %v", calls)
+	}
+	for _, token := range calls {
+		if token != "Bearer at-a" {
+			t.Fatalf("scope leaked: %v", calls)
+		}
+	}
+	w := httptest.NewRecorder()
+	h.ServeHTTP(w, signedScopeRequest("key", []string{"cn:b"}, nil))
+	if w.Code != 200 || calls[len(calls)-1] != "Bearer at-b" {
+		t.Fatal("stale sticky binding survived permission change")
+	}
+}
+func TestAccountScopeRetryNeverFallsBackOutsideSelection(t *testing.T) {
+	p := testPoolWith(&auth.Auth{UID: "bad", AccessToken: "at-bad", ExpiresAt: 9999999999}, &auth.Auth{UID: "good", AccessToken: "at-good", ExpiresAt: 9999999999})
+	var calls []string
+	up := newFakeUpstream(t, func(token string) (int, string, bool) {
+		calls = append(calls, token)
+		if token == "Bearer at-bad" {
+			return 500, `{"code":500}`, false
+		}
+		return 200, sseOK, true
+	})
+	h := NewHandler(Config{Pool: p, Upstream: up, APIKey: "manager-secret"})
+	w := httptest.NewRecorder()
+	h.ServeHTTP(w, signedScopeRequest("key", []string{"cn:bad"}, nil))
+	if w.Code == 200 || len(calls) == 0 {
+		t.Fatalf("wrong retry behavior %d %v", w.Code, calls)
+	}
+	for _, token := range calls {
+		if token != "Bearer at-bad" {
+			t.Fatalf("retry leaked: %v", calls)
+		}
+	}
+}
+func TestAccountScopeDeniedModelListingDoesNotProbePrivateAccount(t *testing.T) {
+	p := testPoolWith(&auth.Auth{UID: "a", AccessToken: "at-a", ExpiresAt: 9999999999})
+	calls := 0
+	up := newFakeUpstream(t, func(token string) (int, string, bool) { calls++; return 200, `{}`, false })
+	h := NewHandler(Config{Pool: p, Upstream: up, APIKey: "manager-secret"})
+	r := signedScopeRequest("key", nil, []string{"cn:a"})
+	r.Method = "GET"
+	r.URL.Path = "/v1/scoped/models"
+	w := httptest.NewRecorder()
+	h.ServeHTTP(w, r)
+	if w.Code != 200 || calls != 0 {
+		t.Fatalf("private model probe: %d calls %d", w.Code, calls)
+	}
+}
+
+func TestAccountScopeIdentitySurvivesGlobalEscapeHatch(t *testing.T) {
+	auth.SetGlobalEnabled(false)
+	defer auth.SetGlobalEnabled(true)
+	account := &auth.Auth{UID: "global-a", Domain: "www.workbuddy.ai"}
+	rule, err := parseAccountScope(signedScopeRequest("public", nil, []string{"global:global-a"}), "manager-secret")
+	if err != nil || account.Realm() != "cn" || rule.permits(account) {
+		t.Fatal("routing toggle released a dedicated account")
+	}
+}
